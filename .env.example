# Relative paths are resolved from backend/.
NEARTALK_DB_PATH=data/neartalk.sqlite3
NEARHELP_DEMO_GUESTS=false

ZHIHU_ACCESS_SECRET=
ZHIHU_HOT_LIMIT=10
ZHIHU_CACHE_TTL=1800
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Enable only if the Zhihu plan permits external model processing of returned excerpts.
ZHIHU_RAG_ENABLED=false

# Backend only. Enables Geoapify place search beyond the CityUHK pilot catalog.
GEOAPIFY_PLACES_KEY=
